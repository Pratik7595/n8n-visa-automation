    {
      "parameters": {
        "jsCode": "// Extract only the required fields from the Twilio WhatsApp webhook payload\nreturn $input.all().map(item => {\n  const payload = item.json.body || {};\n\n  // Phone: \"whatsapp:+919483946253\" -> \"+919483946253\"\n  const user_phone = (payload.From || '').replace('whatsapp:', '').trim();\n\n  // Sender's WhatsApp profile name\n  const user_name = payload.ProfileName || '';\n\n  // Message text (Twilio field: Body)\n  const body = payload.Body || '';\n\n  // Media: Twilio sends NumMedia plus MediaUrl0, MediaUrl1, ...\n  const numMedia = parseInt(payload.NumMedia || '0', 10);\n  const media_url = numMedia > 0 ? (payload.MediaUrl0 || null) : null;\n\n  return {\n    json: {\n      user_phone,\n      user_name,\n      body,\n      media_url\n    }\n  };\n});"
      },
